rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create, update, delete: if isOwner(userId);

      // User Private Chats Subcollection
      match /chats/{chatId} {
        allow get: if isOwner(userId) && isValidId(chatId);
        allow list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(chatId);
        allow delete: if isOwner(userId) && isValidId(chatId);
      }

      // User Private Projects Subcollection
      match /projects/{projectId} {
        allow get: if isOwner(userId) && isValidId(projectId);
        allow list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(projectId);
        allow delete: if isOwner(userId) && isValidId(projectId);
      }
    }
  }
}
