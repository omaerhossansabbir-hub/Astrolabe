{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public and private profile data for authenticated Astrolabe user",
      "type": "object",
      "properties": {
        "displayName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 200 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["email", "createdAt"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "A conversation session belonging to a specific user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "model": { "type": "string", "maxLength": 50 },
        "projectId": { "type": "string", "maxLength": 128 },
        "isPinned": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "messages": { "type": "array" }
      },
      "required": ["userId", "title", "createdAt", "updatedAt"]
    },
    "Project": {
      "title": "Project",
      "description": "User project containing custom system instructions and reference knowledge files",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "customInstructions": { "type": "string", "maxLength": 5000 },
        "color": { "type": "string", "maxLength": 30 },
        "createdAt": { "type": "number" },
        "files": { "type": "array" }
      },
      "required": ["userId", "name", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User document storing account info and profile metadata"
    },
    "/users/{userId}/chats/{chatId}": {
      "schema": { "$ref": "#/entities/ChatSession" },
      "description": "Private chat sessions owned exclusively by the user"
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Private projects and system instructions owned exclusively by the user"
    }
  }
}
